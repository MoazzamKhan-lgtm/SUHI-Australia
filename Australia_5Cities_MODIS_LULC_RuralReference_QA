// ============================================================
// 2. MODIS LAND COVER SETTINGS
// ============================================================

var START_YEAR = 2003;
var END_YEAR = 2024;

var MODIS_LC = ee.ImageCollection('MODIS/061/MCD12Q1');

var LC_SCALE = 500;
var MAX_PIXELS = 1e13;
var TILE_SCALE = 4;


// ============================================================
// 3. MODIS IGBP CLASS GROUPING
// ============================================================
//
// LC_Type1 IGBP classes:
//
// 1  Evergreen Needleleaf Forest
// 2  Evergreen Broadleaf Forest
// 3  Deciduous Needleleaf Forest
// 4  Deciduous Broadleaf Forest
// 5  Mixed Forest
// 6  Closed Shrubland
// 7  Open Shrubland
// 8  Woody Savanna
// 9  Savanna
// 10 Grassland
// 11 Permanent Wetland
// 12 Cropland
// 13 Urban and Built-up
// 14 Cropland/Natural Vegetation Mosaic
// 15 Permanent Snow and Ice
// 16 Barren
// 17 Water
//
// For reviewer response:
//
// Natural/semi-natural vegetation:
// forest + shrubland + savanna + grassland + wetland
//
// Disturbed/managed landscape:
// cropland + cropland/natural vegetation mosaic + built-up
// ============================================================


// ============================================================
// 4. HELPER FUNCTION: GET LAND-COVER IMAGE FOR ONE YEAR
// ============================================================

function getLCImage(year) {

  year = ee.Number(year);

  var img = MODIS_LC
    .filter(ee.Filter.calendarRange(year, year, 'year'))
    .first()
    .select('LC_Type1')
    .rename('lc');

  return img;

}


// ============================================================
// 5. HELPER FUNCTION: BUILD AREA IMAGE BY CLASS GROUP
// ============================================================

function buildAreaImage(lc) {

  var areaKm2 = ee.Image.pixelArea().divide(1e6);

  var valid = lc.gte(1).and(lc.lte(17));

  // Main land-cover groups
  var forest = lc.gte(1).and(lc.lte(5));
  var shrubland = lc.eq(6).or(lc.eq(7));
  var savanna = lc.eq(8).or(lc.eq(9));
  var grassland = lc.eq(10);
  var wetland = lc.eq(11);

  var cropland = lc.eq(12);
  var builtup = lc.eq(13);
  var cropMosaic = lc.eq(14);

  var snowIce = lc.eq(15);
  var barren = lc.eq(16);
  var water = lc.eq(17);

  // Aggregated reviewer-relevant classes
  var naturalVeg = forest
    .or(shrubland)
    .or(savanna)
    .or(grassland)
    .or(wetland);

  var croplandTotal = cropland.or(cropMosaic);

  var disturbedManaged = cropland
    .or(cropMosaic)
    .or(builtup);

  var land = valid.and(water.not());

  var areaImage = ee.Image.cat([

    areaKm2.updateMask(forest).rename('forest_km2'),
    areaKm2.updateMask(shrubland).rename('shrubland_km2'),
    areaKm2.updateMask(savanna).rename('savanna_km2'),
    areaKm2.updateMask(grassland).rename('grassland_km2'),
    areaKm2.updateMask(wetland).rename('wetland_km2'),

    areaKm2.updateMask(cropland).rename('cropland_km2'),
    areaKm2.updateMask(cropMosaic).rename('cropland_mosaic_km2'),
    areaKm2.updateMask(builtup).rename('builtup_km2'),

    areaKm2.updateMask(snowIce).rename('snow_ice_km2'),
    areaKm2.updateMask(barren).rename('barren_km2'),
    areaKm2.updateMask(water).rename('water_km2'),

    areaKm2.updateMask(naturalVeg).rename('natural_vegetation_km2'),
    areaKm2.updateMask(croplandTotal).rename('cropland_total_km2'),
    areaKm2.updateMask(disturbedManaged).rename('disturbed_managed_km2'),

    areaKm2.updateMask(valid).rename('total_valid_area_km2'),
    areaKm2.updateMask(land).rename('total_land_area_km2')

  ]);

  return areaImage;

}


// ============================================================
// 6. HELPER FUNCTION: SAFE NUMBER FROM DICTIONARY
// ============================================================

function getNumber(dict, key) {
  return ee.Number(ee.Dictionary(dict).get(key, 0));
}


// ============================================================
// 7. HELPER FUNCTION: BUILD ONE ANNUAL FEATURE
// ============================================================

function buildAnnualLULCFeature(cityName, zoneName, zoneFC, year) {

  var lc = getLCImage(year);
  var areaImage = buildAreaImage(lc);

  var stats = areaImage.reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: zoneFC.geometry(),
    scale: LC_SCALE,
    maxPixels: MAX_PIXELS,
    tileScale: TILE_SCALE
  });

  var landArea = getNumber(stats, 'total_land_area_km2');
  var totalArea = getNumber(stats, 'total_valid_area_km2');

  var forest = getNumber(stats, 'forest_km2');
  var shrubland = getNumber(stats, 'shrubland_km2');
  var savanna = getNumber(stats, 'savanna_km2');
  var grassland = getNumber(stats, 'grassland_km2');
  var wetland = getNumber(stats, 'wetland_km2');

  var cropland = getNumber(stats, 'cropland_km2');
  var cropMosaic = getNumber(stats, 'cropland_mosaic_km2');
  var builtup = getNumber(stats, 'builtup_km2');

  var snowIce = getNumber(stats, 'snow_ice_km2');
  var barren = getNumber(stats, 'barren_km2');
  var water = getNumber(stats, 'water_km2');

  var naturalVeg = getNumber(stats, 'natural_vegetation_km2');
  var croplandTotal = getNumber(stats, 'cropland_total_km2');
  var disturbedManaged = getNumber(stats, 'disturbed_managed_km2');

  // Percentages relative to land area.
  // This is important because water should not dominate the denominator.
  var forestPct = forest.divide(landArea).multiply(100);
  var shrublandPct = shrubland.divide(landArea).multiply(100);
  var savannaPct = savanna.divide(landArea).multiply(100);
  var grasslandPct = grassland.divide(landArea).multiply(100);
  var wetlandPct = wetland.divide(landArea).multiply(100);

  var croplandPct = cropland.divide(landArea).multiply(100);
  var cropMosaicPct = cropMosaic.divide(landArea).multiply(100);
  var builtupPct = builtup.divide(landArea).multiply(100);

  var snowIcePct = snowIce.divide(landArea).multiply(100);
  var barrenPct = barren.divide(landArea).multiply(100);

  var naturalVegPct = naturalVeg.divide(landArea).multiply(100);
  var croplandTotalPct = croplandTotal.divide(landArea).multiply(100);
  var disturbedManagedPct = disturbedManaged.divide(landArea).multiply(100);

  // Water is relative to total valid area.
  var waterPctTotal = water.divide(totalArea).multiply(100);

  // Reviewer-oriented rural reference flag.
  var referenceFlag = ee.Algorithms.If(
    builtupPct.gt(10),
    'Potential peri-urban contamination: built-up >10%',
    ee.Algorithms.If(
      croplandTotalPct.gt(40),
      'Agricultural/cropland-influenced reference',
      ee.Algorithms.If(
        naturalVegPct.gte(70),
        'Mostly natural or semi-natural vegetation',
        'Mixed rural reference landscape'
      )
    )
  );

  return ee.Feature(null, {

    city: cityName,
    zone: zoneName,
    year: year,

    total_valid_area_km2: totalArea,
    total_land_area_km2: landArea,

    forest_km2: forest,
    shrubland_km2: shrubland,
    savanna_km2: savanna,
    grassland_km2: grassland,
    wetland_km2: wetland,

    cropland_km2: cropland,
    cropland_mosaic_km2: cropMosaic,
    builtup_km2: builtup,

    snow_ice_km2: snowIce,
    barren_km2: barren,
    water_km2: water,

    natural_vegetation_km2: naturalVeg,
    cropland_total_km2: croplandTotal,
    disturbed_managed_km2: disturbedManaged,

    forest_pct_land: forestPct,
    shrubland_pct_land: shrublandPct,
    savanna_pct_land: savannaPct,
    grassland_pct_land: grasslandPct,
    wetland_pct_land: wetlandPct,

    cropland_pct_land: croplandPct,
    cropland_mosaic_pct_land: cropMosaicPct,
    builtup_pct_land: builtupPct,

    snow_ice_pct_land: snowIcePct,
    barren_pct_land: barrenPct,
    water_pct_total: waterPctTotal,

    natural_vegetation_pct_land: naturalVegPct,
    cropland_total_pct_land: croplandTotalPct,
    disturbed_managed_pct_land: disturbedManagedPct,

    rural_reference_flag: referenceFlag

  });

}


// ============================================================
// 8. CREATE ANNUAL LULC COMPOSITION TABLE
// ============================================================

var annualFeatures = [];

for (var year = START_YEAR; year <= END_YEAR; year++) {

  CITIES.forEach(function(cityObj) {

    annualFeatures.push(
      buildAnnualLULCFeature(
        cityObj.name,
        'Urban',
        cityObj.urban,
        year
      )
    );

    annualFeatures.push(
      buildAnnualLULCFeature(
        cityObj.name,
        'Rural',
        cityObj.rural,
        year
      )
    );

  });

}

var annualLULC = ee.FeatureCollection(annualFeatures);

