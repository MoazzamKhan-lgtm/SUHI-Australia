var summaryProperties = [

  'forest_pct_land',
  'shrubland_pct_land',
  'savanna_pct_land',
  'grassland_pct_land',
  'wetland_pct_land',

  'cropland_pct_land',
  'cropland_mosaic_pct_land',
  'cropland_total_pct_land',
  'builtup_pct_land',

  'barren_pct_land',
  'water_pct_total',

  'natural_vegetation_pct_land',
  'disturbed_managed_pct_land'

];


function buildPeriodSummaryFeature(cityName, zoneName) {

  var subset = annualLULC
    .filter(ee.Filter.eq('city', cityName))
    .filter(ee.Filter.eq('zone', zoneName));

  var props = ee.Dictionary({
    city: cityName,
    zone: zoneName,
    start_year: START_YEAR,
    end_year: END_YEAR,
    n_years: subset.size()
  });

  summaryProperties.forEach(function(propName) {

    props = props
      .set('mean_' + propName, subset.aggregate_mean(propName))
      .set('min_' + propName, subset.aggregate_min(propName))
      .set('max_' + propName, subset.aggregate_max(propName));

  });

  var meanNatural = ee.Number(props.get('mean_natural_vegetation_pct_land'));
  var meanCrop = ee.Number(props.get('mean_cropland_total_pct_land'));
  var meanBuilt = ee.Number(props.get('mean_builtup_pct_land'));

  var overallFlag = ee.Algorithms.If(
    meanBuilt.gt(10),
    'Potential peri-urban contamination: built-up >10%',
    ee.Algorithms.If(
      meanCrop.gt(40),
      'Agricultural/cropland-influenced reference',
      ee.Algorithms.If(
        meanNatural.gte(70),
        'Mostly natural or semi-natural vegetation',
        'Mixed rural reference landscape'
      )
    )
  );

  props = props.set('overall_reference_flag', overallFlag);

  return ee.Feature(null, props);

}


var summaryFeatures = [];

CITIES.forEach(function(cityObj) {

  summaryFeatures.push(
    buildPeriodSummaryFeature(cityObj.name, 'Urban')
  );

  summaryFeatures.push(
    buildPeriodSummaryFeature(cityObj.name, 'Rural')
  );

});

var periodMeanLULC = ee.FeatureCollection(summaryFeatures);

