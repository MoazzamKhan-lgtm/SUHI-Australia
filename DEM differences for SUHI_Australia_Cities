];


// ============================================================
// 3. ANALYSIS SETTINGS
// ============================================================

var DEM_SCALE = 30;
var MAX_PIXELS = 1e13;
var TILE_SCALE = 4;

// Standard environmental lapse rate:
// -6.5 °C per 1000 m = -0.0065 °C per metre
var LAPSE_RATE_C_PER_M = -0.0065;

// QA threshold for urban-rural elevation mismatch
var DELTA_ELEVATION_QA_THRESHOLD_M = 50;

// Random-point sampling settings for distribution plots
// Keep this moderate. 2000 per zone gives:
// 5 cities × 2 zones × 2000 = 20,000 points.
// Each point gets all three DEM values.
var SAMPLE_POINTS_PER_ZONE = 2000;
var RANDOM_SEED = 123;


// ============================================================
// 4. VISUALIZATION SETTINGS
// ============================================================

var elevationVis = {
  min: 0,
  max: 600,
  palette: [
    '313695',
    '74add1',
    'ffffbf',
    'fdae61',
    'a50026'
  ]
};

var urbanStyle = {
  color: 'red',
  fillColor: '00000000',
  width: 2
};

var ruralStyle = {
  color: 'blue',
  fillColor: '00000000',
  width: 2
};


// ============================================================
// 5. COMBINED REDUCER FOR CITY-LEVEL STATS
// ============================================================

var elevationReducer = ee.Reducer.mean()
  .combine({
    reducer2: ee.Reducer.median(),
    sharedInputs: true
  })
  .combine({
    reducer2: ee.Reducer.min(),
    sharedInputs: true
  })
  .combine({
    reducer2: ee.Reducer.max(),
    sharedInputs: true
  })
  .combine({
    reducer2: ee.Reducer.stdDev(),
    sharedInputs: true
  })
  .combine({
    reducer2: ee.Reducer.count(),
    sharedInputs: true
  })
  .combine({
    reducer2: ee.Reducer.percentile(
      [5, 25, 75, 95],
      ['p5', 'p25', 'p75', 'p95']
    ),
    sharedInputs: true
  });


// ============================================================
// 6. HELPER FUNCTION: AREA IN KM2
// ============================================================

function getAreaKm2(regionFC) {

  return regionFC.geometry()
    .area({
      maxError: 1
    })
    .divide(1e6);

}


// ============================================================
// 7. HELPER FUNCTION: REDUCE DEM OVER REGION
// ============================================================

function getElevationStats(demImage, regionFC) {

  var stats = demImage.reduceRegion({
    reducer: elevationReducer,
    geometry: regionFC.geometry(),
    scale: DEM_SCALE,
    maxPixels: MAX_PIXELS,
    tileScale: TILE_SCALE
  });

  return ee.Dictionary(stats);

}


// ============================================================
// 8. HELPER FUNCTION: BUILD ONE URBAN-RURAL FEATURE
// ============================================================

function buildUrbanRuralFeature(cityObj, demName, demImage) {

  var urbanStats = getElevationStats(demImage, cityObj.urban);
  var ruralStats = getElevationStats(demImage, cityObj.rural);

  var urbanMean = ee.Number(urbanStats.get('elevation_mean'));
  var ruralMean = ee.Number(ruralStats.get('elevation_mean'));

  var urbanMedian = ee.Number(urbanStats.get('elevation_median'));
  var ruralMedian = ee.Number(ruralStats.get('elevation_median'));

  var deltaElevMean = urbanMean.subtract(ruralMean);
  var deltaElevMedian = urbanMedian.subtract(ruralMedian);

  var absDeltaElevMean = deltaElevMean.abs();

  var lapseBiasMean = deltaElevMean.multiply(LAPSE_RATE_C_PER_M);
  var lapseBiasMedian = deltaElevMedian.multiply(LAPSE_RATE_C_PER_M);

  var qaFlag = ee.Algorithms.If(
    absDeltaElevMean.gt(DELTA_ELEVATION_QA_THRESHOLD_M),
    'Check: elevation difference may bias SUHI',
    'OK'
  );

  var properties = ee.Dictionary({

    city: cityObj.name,
    dem: demName,

    urban_area_km2: getAreaKm2(cityObj.urban),
    rural_area_km2: getAreaKm2(cityObj.rural),

    urban_mean_m: urbanStats.get('elevation_mean'),
    urban_median_m: urbanStats.get('elevation_median'),
    urban_min_m: urbanStats.get('elevation_min'),
    urban_max_m: urbanStats.get('elevation_max'),
    urban_stdDev_m: urbanStats.get('elevation_stdDev'),
    urban_count: urbanStats.get('elevation_count'),
    urban_p5_m: urbanStats.get('elevation_p5'),
    urban_p25_m: urbanStats.get('elevation_p25'),
    urban_p75_m: urbanStats.get('elevation_p75'),
    urban_p95_m: urbanStats.get('elevation_p95'),

    rural_mean_m: ruralStats.get('elevation_mean'),
    rural_median_m: ruralStats.get('elevation_median'),
    rural_min_m: ruralStats.get('elevation_min'),
    rural_max_m: ruralStats.get('elevation_max'),
    rural_stdDev_m: ruralStats.get('elevation_stdDev'),
    rural_count: ruralStats.get('elevation_count'),
    rural_p5_m: ruralStats.get('elevation_p5'),
    rural_p25_m: ruralStats.get('elevation_p25'),
    rural_p75_m: ruralStats.get('elevation_p75'),
    rural_p95_m: ruralStats.get('elevation_p95'),

    delta_elevation_mean_m: deltaElevMean,
    delta_elevation_median_m: deltaElevMedian,
    abs_delta_elevation_mean_m: absDeltaElevMean,

    lapse_rate_C_per_m: LAPSE_RATE_C_PER_M,
    lapse_rate_bias_mean_C: lapseBiasMean,
    lapse_rate_bias_median_C: lapseBiasMedian,

    qa_threshold_m: DELTA_ELEVATION_QA_THRESHOLD_M,
    qa_flag: qaFlag

  });

  return ee.Feature(null, properties);

}


// ============================================================
// 9. LOOP THROUGH ALL DEMS AND ALL CITIES FOR STATS
// ============================================================

var outputFeatures = [];

Object.keys(DEMS).forEach(function(demName) {

  var demImage = DEMS[demName];

  CITIES.forEach(function(cityObj) {

    var feature = buildUrbanRuralFeature(
      cityObj,
      demName,
      demImage
    );

    outputFeatures.push(feature);

  });

});

var urbanRuralElevationStats = ee.FeatureCollection(outputFeatures);


// ============================================================
// 10. QA FEATURE COLLECTION
// ============================================================

var qaProblemFeatures = urbanRuralElevationStats.filter(
  ee.Filter.gt(
    'abs_delta_elevation_mean_m',
    DELTA_ELEVATION_QA_THRESHOLD_M
