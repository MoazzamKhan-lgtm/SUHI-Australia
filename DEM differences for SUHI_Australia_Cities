    urban: ee.FeatureCollection('users/farhanmoazzam/Adelaide_urban'),
    rural: ee.FeatureCollection('users/farhanmoazzam/Adelaide_Rural')
  },

  {
    name: 'Brisbane',
    urban: ee.FeatureCollection('users/farhanmoazzam/Brisbane_urban'),
