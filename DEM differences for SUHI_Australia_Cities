// ============================================================
// 18. ROBUST PIXEL-LEVEL SAMPLING
// ============================================================
//
// This replaces the earlier repeated image.sample() approach.
//
// New logic:
// 1. Generate random points inside each urban/rural zone.
// 2. Stack all three DEMs into one image.
// 3. Use sampleRegions() once on the DEM stack.
//
// This avoids "Too many concurrent aggregations".
// ============================================================


// ------------------------------------------------------------
// 18.1 Build DEM stack
// ------------------------------------------------------------

var demStack = DEMS.Copernicus.rename('Copernicus_elevation_m')
  .addBands(DEMS.SRTM.rename('SRTM_elevation_m'))
  .addBands(DEMS.ALOS.rename('ALOS_elevation_m'));


// ------------------------------------------------------------
// 18.2 Generate random points for all cities and zones
// ------------------------------------------------------------

function makeRandomPoints(regionFC, cityName, zoneName, seedOffset) {

  var points = ee.FeatureCollection.randomPoints({
    region: regionFC.geometry(),
    points: SAMPLE_POINTS_PER_ZONE,
    seed: RANDOM_SEED + seedOffset,
    maxError: 1
  });

  points = points.map(function(f) {
    return f.set({
      city: cityName,
      zone: zoneName
    });
  });

  return points;

}


var pointCollections = [];

CITIES.forEach(function(cityObj, index) {

  var urbanPoints = makeRandomPoints(
    cityObj.urban,
    cityObj.name,
    'Urban',
    index * 10 + 1
  );

  var ruralPoints = makeRandomPoints(
    cityObj.rural,
    cityObj.name,
    'Rural',
    index * 10 + 2
  );

  pointCollections.push(urbanPoints);
  pointCollections.push(ruralPoints);

});

var samplePoints = ee.FeatureCollection(pointCollections).flatten();

print(
  'Random sample points preview',
  samplePoints.limit(10)
);


// ------------------------------------------------------------
// 18.3 Sample all three DEMs at the random points
// ------------------------------------------------------------

var elevationPointSamples = demStack.sampleRegions({
  collection: samplePoints,
  scale: DEM_SCALE,
  geometries: false,
  tileScale: TILE_SCALE
});

print(
  'Elevation point samples preview',
  elevationPointSamples.limit(10)
);


