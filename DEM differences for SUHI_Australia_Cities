    .select("elevation")
    .rename("elevation"),

  ALOS: ee.ImageCollection("JAXA/ALOS/AW3D30/V3_2")
    .select("DSM")
    .mosaic()
    .rename("elevation")

};


// ============================================================
// 2. CITY URBAN AND RURAL POLYGONS
// ============================================================

